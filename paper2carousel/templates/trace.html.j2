<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
{% include "_base.css.j2" %}
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--muted); margin: 8px 0 16px; }
.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; margin-right: 5px; }
.trace { margin-top: 20px; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin: 12px 0 16px; }
.stat { background: var(--bg); border-radius: 8px; padding: 8px 10px; }
.stat b { display: block; font-size: 18px; }
.stat span { font-size: 12px; color: var(--muted); }
.rows { font-size: 13px; }
details { border-top: 1px solid var(--border); }
summary {
  list-style: none; cursor: pointer;
  display: grid; grid-template-columns: minmax(150px, 34%) 1fr 72px; gap: 10px; align-items: center;
  padding: 3px 0;
}
summary::-webkit-details-marker { display: none; }
summary:hover { background: var(--bg); }
.name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.name .detail { color: var(--muted); margin-left: 6px; }
.track { position: relative; height: 14px; background: var(--bg); border-radius: 3px; }
.bar { position: absolute; top: 2px; bottom: 2px; border-radius: 2px; min-width: 2px; }
.bar.run { background: var(--text); }
.bar.step { background: var(--accent); }
.bar.chat { background: var(--chat); }
.bar.image { background: var(--image); }
.bar.cached { opacity: 0.35; }
.bar.error { outline: 2px solid #c0392b; }
.ms { text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }
.attrs { margin: 4px 0 10px; padding: 8px 10px; background: var(--bg); border-radius: 6px; }
.attrs div { display: grid; grid-template-columns: 140px 1fr; gap: 8px; word-break: break-all; }
.status { font-size: 11px; padding: 0 6px; border-radius: 999px; background: var(--accent-muted); margin-left: 6px; }
@media (max-width: 600px) {
  summary { grid-template-columns: 1fr 64px; }
  .track { grid-column: 1 / -1; grid-row: 2; }
}
</style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <p class="muted">Every span of the run: the pipeline steps and each model call inside them. Click a row for its attributes.</p>
  <div class="legend">
    <span><i style="background:var(--text)"></i>run</span>
    <span><i style="background:var(--accent)"></i>step</span>
    <span><i style="background:var(--chat)"></i>chat call</span>
    <span><i style="background:var(--image)"></i>image call</span>
    <span><i style="background:var(--chat);opacity:.35"></i>served from cassette</span>
  </div>
  {% for t in traces %}
  <section class="card trace">
    <div class="small muted"><code>{{ t.trace_id }}</code> · started {{ t.started }}</div>
    <div class="stats">
      <div class="stat"><b>{{ "%.1f"|format(t.total_ms / 1000) }} s</b><span>wall time</span></div>
      <div class="stat"><b>{{ t.llm_calls }}</b><span>model calls</span></div>
      <div class="stat"><b>{{ t.cached_calls }}</b><span>from cassettes</span></div>
      <div class="stat"><b>{{ t.tokens_in }} → {{ t.tokens_out }}</b><span>tokens in → out</span></div>
    </div>
    <div class="rows">
      {% for r in t.rows %}
      <details>
        <summary>
          <span class="name" style="padding-left: {{ r.depth * 14 }}px">{{ r.label }}{% if r.status not in ("ok",) %}<span class="status">{{ r.status }}</span>{% endif %}<span class="detail">{{ r.detail }}</span></span>
          <span class="track"><span class="bar {{ r.kind }}{% if r.cached %} cached{% endif %}{% if r.status == 'error' %} error{% endif %}" style="left: {{ r.left }}%; width: {{ r.width }}%"></span></span>
          <span class="ms">{% if r.ms >= 1000 %}{{ "%.1f"|format(r.ms / 1000) }} s{% else %}{{ "%.0f"|format(r.ms) }} ms{% endif %}</span>
        </summary>
        <div class="attrs small">
          {% for k, v in r.attrs.items() %}<div><span class="muted">{{ k }}</span><code>{{ v }}</code></div>{% else %}<span class="muted">no attributes</span>{% endfor %}
        </div>
      </details>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  <footer>Generated by <a href="https://github.com/fodorad/paper2carousel">paper2carousel</a> from <code>trace.jsonl</code>.</footer>
</main>
</body>
</html>
