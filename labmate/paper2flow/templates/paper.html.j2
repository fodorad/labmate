<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }} · paper2flow</title>
<meta name="description" content="A fact-checked overview of “{{ meta.title }}” with its data-flow diagrams, and the evidence for every bullet.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
{% include "_base.css.j2" %}
.back { font-size: 14px; }
.authors { margin: 4px 0 8px; }
.strip { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 2px 12px; }
.strip figure { margin: 0; flex: 0 0 min(78vw, 340px); scroll-snap-align: start; }
.strip.a4 figure { flex-basis: min(80vw, 380px); }
.strip img { width: 100%; display: block; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); }
.actions { display: flex; flex-wrap: wrap; gap: 14px; font-weight: 600; margin: 4px 0 8px; }
.post { white-space: pre-wrap; margin: 0; font: inherit; }
.copy { font: inherit; font-size: 13px; border: 1px solid var(--border); background: var(--bg); color: var(--text); border-radius: 6px; padding: 4px 10px; cursor: pointer; float: right; }
.slide { margin-bottom: 12px; }
.slide h3 { margin: 0 0 8px; font-size: 16px; }
.bullet { margin: 10px 0 0; }
.quote { margin: 4px 0 0 14px; padding-left: 10px; border-left: 3px solid var(--accent-muted); color: var(--muted); font-size: 14px; }
.quote .where { font-size: 12px; }
.fail { color: var(--accent); }
dl.meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin: 0; }
dl.meta div { background: var(--bg); border-radius: 8px; padding: 8px 10px; }
dl.meta dt { font-size: 12px; color: var(--muted); }
dl.meta dd { margin: 0; font-weight: 600; }
</style>
</head>
<body>
<main>
  <a class="back" href="../">← All papers</a>
  <h1 style="margin-top:12px">{{ meta.title }}</h1>
  {% if meta.authors %}<div class="authors muted">{{ meta.authors[:6]|join(", ") }}{% if meta.authors|length > 6 %} et al.{% endif %}</div>{% endif %}
  {% if meta.publication %}<div><b>{{ meta.publication }}</b></div>{% endif %}
  <div class="chips">
    {% if route %}<span class="chip">{{ route.paper_type }} paper</span>{% endif %}
    <span class="chip">{{ metrics.flow_nodes }}-box data flow + {{ metrics.flow_details }} detail diagram{{ "s" if metrics.flow_details != 1 }}</span>
    <span class="chip">{{ metrics.claims_verified }} verified claims</span>
    <span class="chip">{{ metrics.unsupported_first }}/{{ metrics.bullets_first }} first-draft bullets failed the fact-check</span>
  </div>
  {% if meta.url %}<p><a href="{{ meta.url }}">Read the paper</a></p>{% endif %}

  <h2>Overview</h2>
  <p class="muted">The paper, its four blocks, the end-to-end data flow and the detail diagrams that break it down (A4).</p>
  <div class="strip a4">
    {% for p in overview_pages %}
    <figure><a href="overview.pdf"><img src="{{ p }}" alt="Overview page {{ loop.index }} of {{ meta.title }}" loading="lazy"></a></figure>
    {% endfor %}
  </div>
  <div class="actions"><a href="overview.pdf">Download the overview (PDF)</a><a href="trace.html">Trace of the run</a></div>

  <h2>LinkedIn post</h2>
  <p class="muted">The post text to copy, then the diagrams as 4:5 images: attach one, or upload the pages as a document carousel.</p>
  <div class="strip">
    {% for p in post_pages %}
    <figure><a href="post.pdf"><img src="{{ p }}" alt="Post page {{ loop.index }}" loading="lazy"></a></figure>
    {% endfor %}
  </div>
  {% if post %}
  <div class="card"><button class="copy" type="button" onclick="navigator.clipboard.writeText(document.getElementById('post').innerText); this.textContent='Copied'">Copy</button><pre class="post" id="post">{{ post.hook }}

{% for t in post.takeaways %}{{ t.text }}

{% endfor %}{{ post.question }}

Paper: {{ meta.title }}{% if meta.url %} {{ meta.url }}{% endif %}</pre></div>
  {% endif %}
  <div class="actions"><a href="post.pdf">Download the post (PDF)</a></div>

  <h2>Every bullet and its evidence</h2>
  <p class="muted">Each bullet cites claim cards; each card's quote was found verbatim (fuzzy match ≥ 90, numbers exact) in the paper.</p>
  {% for s in slides %}
  <div class="card slide">
    <h3>{{ loop.index }}. {{ s.title }}</h3>
    {% for b in s.bullets %}
    <div class="bullet">{{ b.text }}
      {% for e in b.evidence %}
      <div class="quote">“{{ e.evidence_quote }}” <span class="where">p. {{ e.page }}, {{ e.section }}</span></div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <h2>What the fact-check caught</h2>
  {% if audit %}
  <p class="muted">First-draft bullets that failed, why, and what the evaluator–optimizer loop did about it ({{ rounds }} round{{ "s" if rounds != 1 }}).</p>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>Block</th><th>First draft</th><th>Why it failed</th><th>Outcome</th></tr></thead>
      <tbody>
      {% for a in audit %}
        <tr><td>{{ a.check.slide }}</td><td>{{ a.check.text }}</td><td class="fail">{{ (a.check.problems + ([a.check.verdict ~ ": " ~ a.check.reason] if a.check.verdict != "supported" else []))|join("; ") }}</td><td>{{ a.outcome }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="muted">Every first-draft bullet passed both the exact-number check and the judge.</p>
  {% endif %}

  {% if flows %}
  <h2>What the flow diagrams were checked against</h2>
  <p class="muted">The planner drew the overview and picked the steps to break down; one worker call per step drew its detail. Code accepted a diagram only if it runs from input data to an output, every label names something in the paper's text, and no number is invented.</p>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>Diagram</th><th>Boxes</th><th>Caption</th></tr></thead>
      <tbody>
        <tr><td>{{ flows.overview.title }}</td><td>{{ flows.overview.nodes|map(attribute="label")|join(" → ") }}</td><td>{{ flows.overview.caption }}</td></tr>
        {% for d in flows.details %}
        <tr><td>Detail {{ "ABC"[loop.index0] }}: {{ d.graph.title }}</td><td>{{ d.graph.nodes|map(attribute="label")|join(" → ") }}</td><td>{{ d.graph.caption }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <h2>Run</h2>
  <div class="card">
    <dl class="meta">
      <div><dt>Model calls</dt><dd>{{ metrics.llm_calls }}</dd></div>
      <div><dt>Tokens in / out</dt><dd>{{ metrics.tokens_in }} / {{ metrics.tokens_out }}</dd></div>
      <div><dt>Compute time</dt><dd>{{ "%.0f"|format(metrics.wall_s) }} s</dd></div>
      <div><dt>Fact-check rounds</dt><dd>{{ metrics.rounds }}</dd></div>
      <div><dt>Model swaps (fact-check)</dt><dd>{{ metrics.swaps }}</dd></div>
      <div><dt>Block fit</dt><dd>{{ "%.0f"|format(100 * metrics.block_fit) }}%</dd></div>
    </dl>
    <p class="small muted" style="margin-bottom:0">Replay this run without any model: <code>make verify PAPER={{ meta.paper_id }}</code> · <a href="trace.html">open the trace</a></p>
  </div>

  <footer>Published {{ meta.published }} · <a href="{{ repo_url }}">labmate · paper2flow</a> by <a href="https://adamfodor.com">Ádám Fodor</a></footer>
</main>
</body>
</html>
